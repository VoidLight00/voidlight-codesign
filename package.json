{
  "name": "voidlight-codesign",
  "version": "0.0.0",
  "private": true,
  "description": "VoidLight CoDesign — Korean fork of OpenCoworkAI/open-codesign with Korean UX and provider bridge",
  "license": "MIT",
  "author": "VOIDLIGHT <icthyeon00@gmail.com>",
  "homepage": "https://github.com/VoidLight00/voidlight-codesign",
  "scripts": {
    "bootstrap": "git submodule update --init upstream && pnpm install -r",
    "sync:upstream": "bash scripts/sync-upstream.sh",
    "apply:modules": "bash scripts/apply-modules.sh",
    "build": "bash scripts/build.sh",
    "verify:patches": "bash scripts/verify-patches.sh",
    "verify:parity": "bash scripts/verify-parity.sh",
    "verify:security": "bash scripts/verify-security.sh",
    "release": "bash scripts/release.sh"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
